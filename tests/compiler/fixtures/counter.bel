@Component()
export class Counter {
  count = ref(0);
  items = [1, 2, 3];

  render() {
    return (
      <div>
        <button onClick={() => this.count.value++}>
          Count: {this.count.value}
        </button>
        <if condition={this.count.value >= 3}>
          <p>Big</p>
        </if>
        <else>
          <p>Small</p>
        </else>
        <ul>
          <for each={n of this.items} key={n}>
            <li>Item {n}</li>
          </for>
        </ul>
      </div>
    );
  }
}
